# Copy this file to .env and fill in real values before running
# `docker compose up --build`.

# Required. Signs login session tokens - generate with: openssl rand -hex 32
SESSION_SECRET=

# The administrators. Register your account first, open your profile page
# (it shows your account ID), and put that ID here. Several admins: separate
# the IDs with commas, no quotes needed, e.g.
#   ADMIN_ACCOUNT_ID=8c8ca55b-...,6633b1ba-...
# When set, these accounts are the ONLY ones that can open the admin panel.
# Without it, mark the admin on the server with: npm run make-admin -- <nickname>
# ADMIN_ACCOUNT_ID=

# Optional. Restricts CORS/Socket.io to a specific origin in production.
# Leave unset (or "*") for local development.
# CLIENT_ORIGIN=https://your-domain.example.com

# Optional. Where the SQLite databases and avatars are stored
# (default: backend/data).
# DATA_DIR=/app/backend/data
